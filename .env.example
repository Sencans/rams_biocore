# R.A.M.S. BIO-CORE — copia este archivo a .env y rellena tus claves. NUNCA subas .env a git.
# chmod 600 .env

# --- Claves (todas opcionales: sin ellas el sistema se degrada) ---
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Crea un bot PROPIO con @BotFather (no reutilices el de Nexus IDE). Formato: 123456789:AA...
TELEGRAM_BOT_TOKEN=
# Tu chat_id numérico de Telegram (solo se aceptan mensajes privados tuyos)
CHAT_ID=

# --- Identidad ---
# Tu nombre de pila (Amadeus te llama así). Vacío = te llama por tu rango.
RAMS_USER_NAME=
# Tu rango en el laboratorio (título ocasional y prompt de la consola)
RAMS_LAB_RANK=Lab Mem 001
RAMS_TZ=America/Bogota

# --- Área de Broca (Gemini) ---
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_CALLS_DAY=300
# 1 = Salieri resume con Gemini; 0 = resumen extractivo local (por defecto)
RAMS_COMPRESION_LLM=0
# 1 = el resumen de tu perfil de WhatsApp entra en el prompt del LLM (Gemini y, si lo usas, Puter)
RAMS_PERFIL_EN_PROMPT=1
# 1 = se usa tu perfil de Google Takeout (python -m core.takeout_ingestor): su resumen entra en el prompt
# del LLM (Gemini y, si lo usas, Puter) y sus hechos, en la memoria, que también viaja al LLM como
# recuerdos relevantes. Solo agregados (intereses, sitios conocidos, horarios y estilo); nunca tu nombre
# de pila, URLs, correos, números ni títulos literales. 0 = no se usa: ni resumen ni recuerdos.
RAMS_PERFIL_TAKEOUT_EN_PROMPT=1

# --- Respaldo Puter (IA de respaldo del Área de Broca) ---
# Si Gemini se queda sin cuota (HTTP 429), sin red o llega a GEMINI_MAX_CALLS_DAY, Amadeus sigue
# conversando con Puter.js (https://developer.puter.com), que corre DENTRO de Amadeus Desktop: no
# necesita clave de API. Inicias sesión con TU cuenta de Puter desde la bandeja («Conectar Puter (IA
# de respaldo)…») y el uso se descuenta de tu saldo de Puter. Sin la app de escritorio, sin sesión de
# Puter o con RAMS_OFFLINE=1, Broca sigue con el banco local de frases. 0 = nunca usar Puter.
# Puter recibe lo mismo que Gemini (system prompt de Amadeus, historial y contexto del turno, nunca
# imágenes: si el turno traía una captura, se le avisa de que no puede verla); el resumen de tu
# perfil solo si RAMS_PERFIL_EN_PROMPT=1. Los resúmenes de memoria y la bitácora siguen siendo solo Gemini.
RAMS_PUTER=1
# Modelo de Puter, con el nombre exacto que da la documentación de Puter (docs.puter.com): empieza
# por letra o dígito, como mucho 100 caracteres. Vacío = el modelo por defecto de Amadeus Desktop.
PUTER_MODEL=
# 1 = Puter va ANTES que Gemini (Gemini queda de respaldo); 0 = Gemini primero y Puter de respaldo
RAMS_PUTER_PRIMERO=0
# Tope de pedidos diarios a Puter (se descuentan de TU saldo de Puter; incluye las iniciativas de
# Amadeus). Al llegar, Broca sigue con Gemini o el banco local hasta la medianoche. 0 = nunca usar Puter.
PUTER_MAX_CALLS_DAY=300

# --- Voz ---
ELEVENLABS_VOICE_ID=p7sm2zw5Us66lZr2brDW
ELEVENLABS_MODEL=eleven_v4_turbo
ELEVENLABS_OUTPUT=pcm_24000
EDGE_TTS_VOICE=es-CO-SalomeNeural
RAMS_VOICE=1

# --- Búsqueda web ---
# Opcional: sin clave se usa DuckDuckGo (ddgs)
BRAVE_API_KEY=

# --- VTube Studio ---
VTS_ENABLED=1
VTS_URL=ws://localhost:8001

# --- Avatar 3D VRM (VTuber AI Studio, en el navegador) ---
# Se usa además de VTube Studio. Solo direcciones locales (127.0.0.1 / localhost).
VTUBER_AI_ENABLED=1
VTUBER_AI_URL=http://127.0.0.1:3939
# 1 = si R.A.M.S. no tiene voz propia (sin ElevenLabs ni reproductor), habla la voz del navegador
VTUBER_AI_TTS=1
VTUBER_AI_LANG=es-MX
# Voz del navegador: nombre(s) de voz separados por comas (p. ej. Sabina,Helena) o "female"
VTUBER_AI_VOICE=female
# 1 = globo de texto sobre el avatar cuando habla; 0 (defecto) = solo labios, el texto va al chat
VTUBER_AI_BURBUJA=0

# --- Autonomía corporal del avatar 3D (la decide el conectoma, sin LLM) ---
RAMS_AVATAR_AUTONOMO=1
# Multiplicador de la frecuencia de movimientos, gestos y caras (0 = quieta, 1 = normal, 3 = inquieta)
RAMS_AVATAR_ACTIVIDAD=1.0
# Puede caminar por el escenario
RAMS_AVATAR_CAMINAR=1
# Puede cambiar el encuadre de la cámara por su cuenta
RAMS_AVATAR_CAMARA=0

# --- Cámara (visión activa: parpadeo de milisegundos, nunca guarda imágenes) ---
# Desactivada por defecto. Pon 1 para que Amadeus pueda mirar por la webcam (siempre te avisa).
RAMS_CAMERA=0
RAMS_CAMERA_INDEX=0
RAMS_CAMERA_MIN_INTERVAL_S=90
RAMS_CAMERA_MAX_DIA=40

# --- Hyprland / presencia ---
# Dialecto de hyprctl: se detecta solo. Descomenta para forzarlo (lua | legacy).
# HYPR_DISPATCH_MODE=lua
# Archivo que crea hypridle al quedar inactivo (por defecto $XDG_RUNTIME_DIR/rams_idle; ver README).
# RAMS_IDLE_FLAG=/run/user/1000/rams_idle
RAMS_IDLE_TIMEOUT_S=180
RAMS_AWAY_MINUTES=10
RAMS_APPS=terminal=kitty,navegador=firefox,nexus=nexus-ide

# --- Proactividad ---
# Mensajes proactivos por Telegram al día y horario silencioso (solo Telegram)
RAMS_MAX_PROACTIVE=3
RAMS_QUIET_START=23:00
RAMS_QUIET_END=07:00
# Interrupciones por voz/terminal por hora con el usuario presente
RAMS_MAX_INTERRUPCIONES_HORA=4
# Quién te escribe por Telegram cuando no estás (ver README, sección Telegram):
# hibrido = Amadeus llama y Megumin insiste (fiel a S;G0) | megumin = siempre Megumin | amadeus = nunca Megumin
RAMS_MENSAJERO=hibrido

# --- Nexus IDE ---
# Token de la sesión de colaboración (Ctrl+Alt+L → Alojar; cambia en cada sesión)
NEXUS_COLLAB_TOKEN=
NEXUS_WORKSPACE=
RAMS_CTL_PORT=8766
# 1 = el agente de Nexus puede buscar en tu memoria por MCP (solo hechos y preferencias vividos)
RAMS_MCP_MEMORIA=0

# --- HUD ---
RAMS_HUD=1
RAMS_HUD_PORT=8765
RAMS_HUD_OPEN=0

# --- Amadeus Desktop / escritorio ---
# App de escritorio (Electron, carpeta desktop/): Amadeus vive en la bandeja, sale a caminar por la
# pantalla y tiene chat. Se conecta a ws://127.0.0.1:<RAMS_HUD_PORT>/escritorio con un token propio
# que cambia en cada arranque. 0 = sin endpoint /escritorio (ni app de escritorio ni chat en el HUD).
RAMS_ESCRITORIO=1
# Archivo privado (0o600) con {url, token, pid} que lee Amadeus Desktop. Por defecto:
#   Windows: %LOCALAPPDATA%\rams\escritorio.json
#   Linux:   $XDG_RUNTIME_DIR/rams/escritorio.json
#   Sin XDG_RUNTIME_DIR: data/escritorio.json (entonces define esta variable también para Electron)
# RAMS_ESCRITORIO_TOKEN_FILE=/run/user/1000/rams/escritorio.json
# 1 = las respuestas al chat de escritorio también se dicen en voz alta (regla de voz normal);
# 0 = solo texto en el chat (labios mudos; globo sobre el avatar solo con VTUBER_AI_BURBUJA=1)
RAMS_ESCRITORIO_VOZ=0
# 1 = el HUD del navegador también tiene panel de chat; 0 = el chat solo está en la app de escritorio
RAMS_HUD_CHAT=1
# Tema del avatar en VTuber AI Studio: amadeus = paleta de Kurisu con corbata y medias (homenaje de
# fan, sin assets oficiales) | none = R.A.M.S. nunca fuerza un tema
VTUBER_AI_TEMA=amadeus

# --- Control del PC y travesuras ---
# Amadeus puede abrir apps y webs, buscar y dejar borradores (WhatsApp, Telegram, X, Gmail, correo)
# que TÚ envías: nunca pulsa Enter. Prerrellenar y escribir en otra app siempre piden confirmación.
# Sinónimos propios de destinos (se SUMAN al catálogo), separados por comas: sinonimo=clave
# Claves: whatsapp, telegram, x, gmail, correo, instagram, tiktok, facebook, discord, linkedin,
# youtube, spotify, navegador, archivos. Ejemplo: RAMS_DESTINOS=wasap=whatsapp,twitter=x
RAMS_DESTINOS=
# Travesuras con el cursor REAL (empujoncitos de menos de 0,6 s): desactivadas por defecto; 1 = permitidas.
# La mirada y la persecución visual del cursor siempre están. "basta", "quieta" o Ctrl+Alt+Shift+Q las apagan.
# En Hyprland nunca se mueve el cursor real.
RAMS_TRAVESURAS=0
# Desplazamiento máximo de una travesura, en píxeles (5..80)
RAMS_TRAVESURA_AMPLITUD=40

# --- Visión continua (cámara + pantalla) ---
# Todo en local y sin tokens: nunca guarda ni envía imágenes y funciona aunque R.A.M.S. esté offline.
# Opt-in de dos niveles: RAMS_CAMERA=1 (sección Cámara) Y RAMS_VISION_CONTINUA=1.
RAMS_VISION_CONTINUA=0
# Cuadros por segundo de la cámara continua (1..5)
RAMS_VISION_FPS=3
# Detector de caras: auto (YuNet si está el modelo; si no, Haar) | yunet | haar
RAMS_VISION_DETECTOR=auto
# Ruta al modelo YuNet (.onnx). Vacío = data/models/face_detection_yunet*.onnx
RAMS_VISION_MODELO=
# Ángulo de visión horizontal de tu webcam, en grados (30..120)
RAMS_VISION_HFOV=70
# 1 = tu webcam entrega la imagen en espejo
RAMS_VISION_ESPEJO=0
# Procesos (sin .exe) que pausan la cámara continua y vetan las travesuras: videollamadas, streaming
RAMS_VISION_APPS_PAUSA=zoom,teams,ms-teams,discord,obs64,obs
# Pantalla: off | metadatos (app, título no privado, vídeo, pantalla completa) | pixeles (además
# métricas de imagen; en Windows necesita pip install mss==10.2.0). Desactivada por defecto.
RAMS_PANTALLA_MODO=off
# Muestras de pantalla por segundo (0,2..2)
RAMS_PANTALLA_FPS=1.0
# Títulos EXTRA que nunca se miran (texto literal, separado por comas). Bancos, contraseñas, inicio
# de sesión, navegación privada y gestores de contraseñas se excluyen SIEMPRE.
RAMS_PANTALLA_EXCLUIR=
# 1 = la caja del avatar no cuenta en las métricas de pantalla (Amadeus no se mira a sí misma)
RAMS_PANTALLA_EXCLUIR_AVATAR=1

# --- Conectoma ---
# reducido | stub   (flywire es una herramienta offline en v0.1)
RAMS_CONNECTOME=reducido
# Semilla del ruido (vacía = aleatoria; la topología de la red se guarda en data/)
RAMS_CONNECTOME_SEED=
RAMS_LOG_LEVEL=INFO

# --- Telegram multimedia ---
# 1 = si se lo pides por Telegram ("mándame una foto", "mándame captura"), te envía una foto de la cámara
# o de la pantalla. Siempre avisa en el PC y nunca captura ventanas de bancos/contraseñas. 0 = nunca.
RAMS_TELEGRAM_FOTOS=0
# off | auto (te responde con nota de voz si le mandas voz o se la pides) | siempre
RAMS_TELEGRAM_AUDIO=auto
# 1 = entiende tus notas de voz (las transcribe con Gemini)
RAMS_TELEGRAM_TRANSCRIBIR=1
# 1 = desde Telegram puede abrir apps/webs y buscar en tu PC (nada de teclear, borradores ni travesuras)
RAMS_TELEGRAM_ACCIONES=1
# En Windows, "abre <app>" busca la app en tu menú Inicio (las no aprobadas piden confirmación una vez)
RAMS_APPS_MENU_INICIO=1

# --- v0.2.2: Google (Gmail y Drive) y taller de scripts ---
# 1 = Amadeus puede conectarse a TU cuenta de Google para enviar correos y usar tu Drive (opt-in).
# Antes sigue la guía de docs/V022_CORREO_DRIVE_SCRIPTS.md §17 y guarda el JSON del cliente OAuth de
# escritorio en data/google_cliente.json (nunca lo subas a git). Luego dile «conecta mi cuenta de Google».
RAMS_GOOGLE=0
# Servicios que se piden al conectar, separados por comas: correo, drive (si cambias, reconecta)
RAMS_GOOGLE_SERVICIOS=correo,drive
# Ruta del JSON del cliente OAuth. Vacío = data/google_cliente.json
# Ejemplo: RAMS_GOOGLE_CLIENTE=~/secretos/amadeus_cliente.json
RAMS_GOOGLE_CLIENTE=
# 1 = acceso completo a Drive (modificar cualquier archivo); 0 = leer todo y modificar solo lo que cree Amadeus
RAMS_DRIVE_COMPLETO=0
# Carpeta donde se guardan las descargas de Drive. Vacío = tu carpeta Descargas
# Ejemplo: RAMS_DRIVE_DESCARGAS=~/Descargas/Drive
RAMS_DRIVE_DESCARGAS=
# Tamaño máximo de una descarga de Drive, en MB (1..2048)
RAMS_DRIVE_MAX_DESCARGA_MB=200
# Tamaño máximo de un archivo que subes a Drive, en MB (1..2048)
RAMS_DRIVE_MAX_SUBIDA_MB=100
# Contactos para «escríbele a mamá»: alias=correo separados por comas. Vacío = sin contactos
# mama=mama@gmail.com,jefe=jefe@empresa.com
RAMS_CORREO_CONTACTOS=
# Destinatarios como mucho por correo, sumando Para, CC y CCO (1..50)
RAMS_CORREO_MAX_DESTINATARIOS=10
# Correos enviados como mucho cada 10 minutos (1..20)
RAMS_CORREO_MAX_10MIN=5
# Correos enviados como mucho al día (1..200)
RAMS_CORREO_MAX_DIA=30
# Tamaño máximo de los adjuntos de un correo, en MB (1..24)
RAMS_CORREO_MAX_ADJUNTOS_MB=20
# 1 = desde Telegram puede PREPARAR correos (siempre se aprueban con el botón en el PC; nunca envía solo)
RAMS_TELEGRAM_CORREO=1
# 1 = desde Telegram puede buscar en tu Drive y darte detalles de un archivo (los nombres salen por Telegram)
RAMS_TELEGRAM_DRIVE=0
# 1 = taller de scripts: Amadeus escribe un script (PowerShell, Python o bash) y TÚ ves el código entero
# y lo ejecutas con el botón «Ejecutar» (nunca solo, nunca desde Telegram; sin admin y con tiempo límite)
RAMS_TALLER=0
# 1 = cuando no tiene herramienta para algo, Amadeus te ofrece escribir un script
RAMS_TALLER_OFRECER=1
# Tiempo máximo de ejecución de un script, en segundos (5..300); al vencer se matan todos sus procesos
RAMS_TALLER_TIMEOUT_S=30
# Procesos vivos como mucho de un script, contando sus hijos (1..64)
RAMS_TALLER_MAX_PROC=16
# Memoria máxima de un script, en MB (64..8192)
RAMS_TALLER_MAX_MEM_MB=512
# Bytes de salida que se capturan por flujo (stdout y stderr), 1024..262144
RAMS_TALLER_MAX_SALIDA=16384
